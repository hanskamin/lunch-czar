# Copy to .env.local and fill in. Either Slack option works.

# Option A (recommended): a Slack bot token — needs chat:write scope and the
# bot invited to the channel (/invite @Lunch Czar in #atx-lunch).
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#atx-lunch

# Option B: an incoming webhook already wired to #atx-lunch.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Where "restaurants near the office" searches from. If unset, Lunch Czar
# uses your default DoorDash saved address.
# OFFICE_LAT=30.2672
# OFFICE_LNG=-97.7431
